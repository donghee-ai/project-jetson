[Unit]
Description=Life Trainer — 아침 다이제스트 (키워드 랭킹) + Slack 발송
Documentation=https://github.com/
After=network-online.target

[Service]
# ★ 경로는 %h(사용자 홈)로 쓴다. 절대경로를 박으면 다른 사용자·다른 설치 위치에서
#   조용히 깨진다 — 유닛 12개가 전부 /home/user 에 묶여 있었다 (2026-08-28).
Type=oneshot
WorkingDirectory=%h/project/project-jetson/Life_Trainer
ExecStart=%h/project/project-jetson/Life_Trainer/.venv/bin/lt digest --post

MemoryMax=512M
