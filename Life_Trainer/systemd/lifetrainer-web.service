[Unit]
Description=Life Trainer — 플래너 웹 서버 (상시)
Documentation=https://github.com/
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/user/project/project-jetson/Life_Trainer
ExecStart=/home/user/project/project-jetson/Life_Trainer/.venv/bin/lt web
Restart=always
RestartSec=10

# 폰에서 상시 접근하는 가벼운 Flask 서버다. worker(1G)보다 훨씬 적게 쓰므로
# 낮게 잡는다 — 그래도 상한을 걸어 메모리 누수 시 시스템 전체를 압박하지 않게 한다.
MemoryMax=384M

[Install]
WantedBy=default.target
