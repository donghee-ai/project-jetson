[Unit]
Description=Life Trainer — 야간 배치 적재 (문서 요약 + 미분류 태깅)
Documentation=https://github.com/
After=network.target

[Service]
Type=oneshot
WorkingDirectory=/home/user/project/project-jetson/Life_Trainer
ExecStart=/home/user/project/project-jetson/Life_Trainer/.venv/bin/lt nightly

# 여기서는 큐에 넣기만 한다 — LLM 호출은 상시 워커(lifetrainer-worker.service)가
# 하므로 이 유닛은 메모리를 거의 안 쓴다.
MemoryMax=512M
