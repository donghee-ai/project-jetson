[Unit]
Description=Life Trainer — GPU 잡 워커 (상시)
Documentation=https://github.com/
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/user/project/project-jetson/Life_Trainer
ExecStart=/home/user/project/project-jetson/Life_Trainer/.venv/bin/lt worker
Restart=always
RestartSec=10

# GPU 잡은 fcntl 프로세스 락(data/gpu.lock)으로 단일 실행을 강제하므로 두 번째
# 인스턴스가 떠도 즉시 종료한다 — 그래도 메모리 상한은 걸어둔다. llama-server 가
# 이미 ~10.4GB 를 쓰는 상태라 파이썬 쪽이 그 이상 자라면 안 된다.
MemoryMax=1G

[Install]
WantedBy=default.target
