[Unit]
Description=llama.cpp 8B 서버 주기 재기동 (매일 06:10)

[Timer]
# 하루 두 번. **둘 다 이유가 다르다.**
#
#   02:00  야간 배치 직전 — 8B 가 하루 중 가장 무거운 일을 하는 시각이다
#          (요약 30건 × 실측 19.5초). 여기서 비우면 배치가 6,840MB 에서
#          시작한다. 안 비우면 06:10 이후 20시간 자란 약 9,400MB 에서 시작했다.
#          배치는 10분 뒤(02:10)에 시작하므로 로드(10~30초)에 여유가 크다.
#   06:10  야간 창(05:50 종료 · 실측 3~6분)이 닫힌 뒤, 백업(06:20) 전.
#          낮 시간을 가벼운 상태로 시작한다.
#
# ★ 하루 한 번으로도 계산상 안전하다(24시간 후 약 9,950MB, 전역 OOM 이 난
#   12,296MB 까지 18시간 여유). 두 번으로 늘린 이유는 **최대 크기를 줄이는 것보다
#   가장 무거운 작업을 가장 가벼운 상태에서 돌리려는 것**이다.
OnCalendar=*-*-* 02:00:00
OnCalendar=*-*-* 06:10:00
# ★ Persistent=false 로 둔다. 놓친 실행을 부팅 직후에 따라잡으면
#   방금 뜬 서버를 다시 내리는 꼴이다 — 이 작업은 밀려도 다음 날이면 된다.
Persistent=false
AccuracySec=1min

[Install]
WantedBy=timers.target
