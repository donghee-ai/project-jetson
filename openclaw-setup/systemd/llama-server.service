[Unit]
Description=llama.cpp server (Qwen3-8B-Q4_K_M) — OpenClaw model backend
Documentation=https://github.com/ggml-org/llama.cpp
After=network.target

[Service]
Type=exec
Environment=HOME=/home/user
ExecStart=/home/user/project/project-jetson/openclaw-setup/bin/llama-server-qwen3.sh

# 모델 로드(약 10초, 페이지 캐시가 비면 그 이상)가 끝나 /health 가 200 을 줄 때까지
# 유닛을 "기동 중"으로 잡아둔다. 이게 있어야 openclaw-gateway 의 After= 가 실제로
# 의미를 갖는다 — 없으면 게이트웨이가 모델보다 먼저 떠서 첫 턴이 실패한다.
ExecStartPost=/bin/sh -c 'until /usr/bin/curl -sf --max-time 3 http://127.0.0.1:8080/health >/dev/null 2>&1; do sleep 2; done'
TimeoutStartSec=600

Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=30

# 16GB 통합 메모리에서 모델(≈4.7GB) + KV 캐시(≈3.1GB)를 쓴다.
# OOM 시 커널이 이 프로세스를 우선 죽이지 않도록 점수를 낮춘다.
OOMScoreAdjust=-200

[Install]
WantedBy=default.target
