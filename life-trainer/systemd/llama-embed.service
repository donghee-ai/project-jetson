[Unit]
Description=llama.cpp embedding server (Qwen3-Embedding-0.6B) — Life Trainer RAG
After=network-online.target
Wants=network-online.target

[Service]
# ★ 경로는 %h(사용자 홈)로 쓴다. 절대경로를 박으면 다른 사용자·다른 설치 위치에서
#   조용히 깨진다 — 유닛 12개가 전부 /home/user 에 묶여 있었다 (2026-08-28).
# 대화 모델(:8080)과 **다른 프로세스**다. llama.cpp 는 프로세스당 모델 하나라
# 임베딩 전용 서버를 따로 띄운다. 0.6B Q8_0 이 약 610MB 라 8B(10.2GB) 옆에 든다.
#
# --embedding : 생성 경로를 막고 /v1/embeddings 만 연다
# ★ -ngl 0 : **CPU 로 돌린다.** GPU 에 올렸더니(-ngl 99) 상주가 3,144MB 로 불어
#   8B 가 CUDA 버퍼 4.67GB 를 못 잡고 기동에 실패했다. 모델 파일은 610MB 인데
#   컨텍스트·계산 버퍼가 그만큼 붙는다. 8B 가 이 기기의 주인공이므로 임베딩이 양보한다.
#   임베딩은 질의 1건이 수백 ms, 야간 배치도 밤에 도는 일이라 CPU 로 충분하다.
# ★ -t 3 : 8코어를 8B 와 나눠 쓴다. 스레드를 안 묶었더니 8B(67% CPU)와 붙어
#   부하가 20 까지 올라가고 임베딩 한 건이 15초까지 늘었다(실측).
# ★ -c 는 **슬롯 전체 합**이다. --parallel N 이면 슬롯당 -c/N 토큰만 쓴다.
#   처음에 `-c 2048 --parallel 4` 로 뒀더니 슬롯당 512 토큰이 되어, 1600자(≈800토큰)
#   짜리 문서 하나조차 "exceeds the available context size (512 tokens)" 로 거부됐다.
#   8192/4 = 슬롯당 2048 토큰 — 상한 1600자에 여유가 있다.
#   더 크게(16384/8 · -b 16384) 잡았더니 MemoryMax=2G 에 걸려 OOM 으로 죽었다.
# -b 는 한 요청에 들어오는 **총 토큰**이다. 16건 × 800토큰이 한 번에 오므로 넉넉히 준다.
# ★★ 2026-08-29 — `-ngl 0` 인데 CUDA 백엔드가 켜져 dmabuf(nvmap) 646MB 를 쥐고 있었다.
#   CUDA_VISIBLE_DEVICES 를 비우면 장치를 못 찾아 초기화를 건너뛴다 (실측 646MB -> 0).
#   상주는 1,793 -> 1,702MB. 요청당 증가는 **입력 길이**가 정하지 요청 수가 아니다
#   (짧은 문장 60건 +75MB / 1,600자 문서 40건 +1,137MB, 둘 다 그 뒤 평탄).
#   근거와 남은 것: docs/issues/0018
#   되돌리기: 이 세 줄을 지우고 daemon-reload && restart llama-embed
Environment=CUDA_VISIBLE_DEVICES=
Environment=MALLOC_ARENA_MAX=2
Environment=MALLOC_TRIM_THRESHOLD_=131072
ExecStart=%h/llama.cpp/build/bin/llama-server \
  -m %h/models/Qwen3-Embedding-0.6B-Q8_0.gguf \
  --alias qwen3-embedding-0.6b \
  --embedding \
  -ngl 0 \
  -c 4096 \
  --parallel 2 \
  -t 3 \
  -b 2048 -ub 512 \
  --host 127.0.0.1 --port 8081
ExecStartPost=/bin/sh -c 'until /usr/bin/curl -sf --max-time 3 http://127.0.0.1:8081/health >/dev/null 2>&1; do sleep 2; done'
Restart=on-failure
RestartSec=10
# ★★ 2026-08-23 저녁 실측: **이 서버는 요청이 쌓이면 메모리가 계속 는다.**
#
#   유휴 상주는 1.8GB 인데, 초록 백필 + 재임베딩으로 약 1,380건을 처리하고 나니
#   RSS 1.2GB + **스왑 5.5GB = 6.7GB** 였다. 610MB 모델이 그럴 이유가 없다.
#   재시작하니 즉시 1.8GB 로 돌아왔다 — 누수지 작업량이 아니다.
#
#   ★ 상한을 올린 것이 오히려 해로웠다:
#       2G → 스왑으로 2.4GB 밀림 (느려짐)
#       3G → OOM 으로 죽고 재시작       ← **자가복구된다. 이게 낫다**
#       4G → 스왑 7.8GB 를 전부 먹고 **8B 까지 끌어내렸다** (가용 112MB)
#
#   그래서 상한을 도로 낮추고, **스왑을 아예 막는다.** 누수가 나면 스왑으로
#   기어 들어가 기기 전체를 끌어내리는 대신 빨리 죽고 빨리 살아나야 한다.
#   `Restart=on-failure` 가 그 자리를 받는다.
#
#   근본 해결(llama.cpp 쪽 누수)은 아직 안 했다. 큰 배치를 돌린 뒤에는
#   `systemctl --user restart llama-embed` 로 상주를 되돌리는 것이 안전하다.
MemoryMax=2500M
MemorySwapMax=0

[Install]
WantedBy=default.target
