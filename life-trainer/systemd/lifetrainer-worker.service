[Unit]
Description=Life Trainer — GPU 잡 워커 (상시)
Documentation=https://github.com/
After=network.target

[Service]
# ★ 경로는 %h(사용자 홈)로 쓴다. 절대경로를 박으면 다른 사용자·다른 설치 위치에서
#   조용히 깨진다 — 유닛 12개가 전부 /home/user 에 묶여 있었다 (2026-08-28).
Type=simple
WorkingDirectory=%h/project/project-jetson/life-trainer
ExecStart=%h/project/project-jetson/life-trainer/.venv/bin/lt worker
Restart=always
RestartSec=10

# GPU 잡은 fcntl 프로세스 락(data/gpu.lock)으로 단일 실행을 강제하므로 두 번째
# 인스턴스가 떠도 즉시 종료한다 — 그래도 메모리 상한은 걸어둔다. llama-server 가
# 이미 ~10.4GB 를 쓰는 상태라 파이썬 쪽이 그 이상 자라면 안 된다.
MemoryMax=1G

[Install]
WantedBy=default.target
