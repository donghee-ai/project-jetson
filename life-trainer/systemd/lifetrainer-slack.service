[Unit]
Description=Life Trainer — Slack Socket Mode (/lt, /log 슬래시 커맨드)
Documentation=https://github.com/
After=network-online.target

[Service]
# ★ 경로는 %h(사용자 홈)로 쓴다. 절대경로를 박으면 다른 사용자·다른 설치 위치에서
#   조용히 깨진다 — 유닛 12개가 전부 /home/user 에 묶여 있었다 (2026-08-28).
Type=simple
WorkingDirectory=%h/project/project-jetson/life-trainer
ExecStart=%h/project/project-jetson/life-trainer/.venv/bin/lt slack serve
Restart=always
RestartSec=10

MemoryMax=512M

# 주의: 기본적으로 enable 하지 않는다. 지금은 config/lifetrainer.toml 의
# [slack].mode 가 "notify" 라 이 서비스가 필요 없다 (발송 전용, 슬래시 커맨드 없음).
# mode 를 "bolt" 로 바꾸고 전용 앱 토큰(app_token)을 채운 뒤에만 의미가 있다
# (docs/contracts.md §6, docs/implementation-plan.md §1-4 참고).
[Install]
WantedBy=default.target
