# ══════════════════════════════════════════════════════════════
#  모델 가중치 — 절대 커밋 금지 (현재 18.8 GB)
# ══════════════════════════════════════════════════════════════
# 디렉토리 전체를 막고 문서만 예외 처리.
# ("models/*.gguf" 식은 하위 디렉토리를 못 막는다 — 실측 확인됨)
refs/models/*
!refs/models/README.md
!refs/models/.gitkeep

# 어디에 있든 모델 파일은 차단 (안전망)
*.gguf
*.safetensors
*.pt
*.pth
*.onnx
*.engine
*.bin
*.part

# ══════════════════════════════════════════════════════════════
#  레퍼런스 — 남의 저장소 클론 (각자 별도 git)
# ══════════════════════════════════════════════════════════════
refs/reference/*
!refs/reference/README.md
!refs/reference/.gitkeep

# ══════════════════════════════════════════════════════════════
#  측정 결과 — 요약(.txt/.json)은 커밋, 원본은 제외
# ══════════════════════════════════════════════════════════════
measure/results/*.log
measure/results/server-*

# Nsight 원본 — 바이너리이고 `measure/tools/profile-decode.sh` 로 재생성된다.
# 읽을 수 있는 요약(*.kernels.csv)만 커밋한다.
*.nsys-rep
*.qdstrm
*.qdrep

# 음성 원본. 전부 스크립트로 재생성된다
# (speech-bench.py / asr-source-test.py 는 TTS 합성, mic-live-bench.py 는 마이크 녹음).
# ★ measure/results/speech/live/ 는 **사람 목소리 실제 녹음**이다 — 개인 데이터라 절대 커밋 금지.
*.wav
*.flac
*.mp3
*.ogg

# ══════════════════════════════════════════════════════════════
#  빌드 산출물
# ══════════════════════════════════════════════════════════════
*.ko
*.o
*.mod
*.mod.c
*.cmd
.tmp_versions/
modules.order
Module.symvers
__pycache__/
*.pyc
node_modules/

# 파이썬 도구 산출물 (하위 프로젝트에도 각자 있지만, 어디서 생기든 막는 안전망)
# ★ `.venv*/` 까지 막는다 (2026-09-07). 전에는 `.venv/` 하나였고, 파이썬을 올리며
#   만든 `.venv310/` 이 **그대로 통과했다** — `git add -A` 한 번에 파이썬 설치본이
#   저장소에 들어갈 뻔했다(검사기가 그 안의 .py 를 훑어 65건을 뱉어 알아챘다).
#   이 저장소는 같은 구멍을 이미 한 번 겪었다:
#   HISTORY/2026-08-25-the-gitignore-net-had-a-suffix-shaped-hole.md
.venv/
.venv*/
venv/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
build/
dist/

# ══════════════════════════════════════════════════════════════
#  개인 데이터 · 비밀 — 어디에 있든 차단 (안전망)
# ══════════════════════════════════════════════════════════════
# life-trainer/.gitignore 가 data/ 와 config/lifetrainer.toml 을 이미 막지만,
# 새 하위 프로젝트가 생겼을 때 여기서 한 번 더 걸리게 둔다.
# 활동 기록 DB 에는 창 제목이 그대로 들어 있다 (개인 기록).
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
websecret
*.lock
!package-lock.json
secrets.*
*.pem
*.key

# ══════════════════════════════════════════════════════════════
#  로그 · 임시 · 잡파일
# ══════════════════════════════════════════════════════════════
*.log
nohup.out
core
core.*
*.tmp
*.swp
.DS_Store

# 복구 묶음 — 토큰·키·개인 활동 기록이 들어 있다. 절대 커밋하지 않는다.
recovery-bundle-*.tar.gz
recovery-bundle-*.sha256

# ★ 이 기기에만 두는 금지어 목록 (operate/tools/check-privacy.sh 가 읽는다).
#   막을 낱말을 저장소에 적으면 **그 목록이 곧 개인정보**라 여기서 막는다.
private-terms.local.txt
